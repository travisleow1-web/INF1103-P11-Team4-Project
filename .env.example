# Copy this file to .env and fill in what you need. Never commit .env.

# 1 shows the app with the fake AI and rules from tests/fakes.py and a yellow banner.
DEMO_MODE=
# Demo mode keeps its records here, never in DATA_FILE or MongoDB (default demo_records.json).
DEMO_DATA_FILE=

# Where records are saved: json (the default) or mongo.
DATA_BACKEND=
# JSON backend: the file to use (default shipment_records.json).
DATA_FILE=

# MongoDB backend: both are needed when DATA_BACKEND=mongo. Records go to the shipment_records collection.
MONGO_URI=
DB_NAME=

# AI layer: without a key the AI is not connected. Never commit a real key.
GEMINI_API_KEY=
# Optional: Gemini model name (default gemini-3.5-flash-lite) and AI cache file (default ai_cache.json).
GEMINI_MODEL=
AI_CACHE_FILE=
